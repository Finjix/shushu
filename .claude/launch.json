{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shushu-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8010",
        "--bind",
        "127.0.0.1",
        "--directory",
        "public"
      ],
      "port": 8010
    },
    {
      "name": "shushu-static-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8023",
        "--bind",
        "127.0.0.1",
        "--directory",
        "public"
      ],
      "port": 8023,
      "autoPort": false
    },
    {
      "name": "shushu-dev",
      "port": 8000,
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/dev-server.py"
      ]
    },
    {
      "name": "shushu-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@latest",
        "pages",
        "dev",
        "public",
        "--port",
        "8788",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8788
    }
  ]
}
